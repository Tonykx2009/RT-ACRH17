# OpenWrt v25.12.6 for ASUS RT-ACRH17 (asus_rt-ac42u)
CONFIG_TARGET_ipq40xx=y
CONFIG_TARGET_ipq40xx_generic=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_TARGET_DEVICE_ipq40xx_generic_DEVICE_asus_rt-ac42u=y
CONFIG_TARGET_DEVICE_PACKAGES_ipq40xx_generic_DEVICE_asus_rt-ac42u=y

# LuCI Web 界面
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-opkg=y

# 中文语言包
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-opkg-zh-cn=y

# 基础网络与工具
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_openssh-sftp-server=y

# 常用内核模块（USB 支持等）
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-ledtrig-usbport=y

# 无线驱动固件（RT-ACRH17 所需）
CONFIG_PACKAGE_ath10k-firmware-qca9984-ct=y
CONFIG_PACKAGE_ipq-wifi-asus_rt-ac42u=y

# ========== 在此处追加你的自定义插件 ==========
# 示例：
# CONFIG_PACKAGE_luci-app-passwall=y
# CONFIG_PACKAGE_luci-app-openclash=y
# 自定义插件
CONFIG_PACKAGE_luci-i18n-ddns-zh-cn=y 
CONFIG_PACKAGE_https-dns-proxy=y 
CONFIG_PACKAGE_luci-app-https-dns-proxy=y 
CONFIG_PACKAGE_luci-i18n-https-dns-proxy-zh-cn=y 
CONFIG_PACKAGE_luci-app-adblock=y 
CONFIG_PACKAGE_luci-i18n-adblock-zh-cn=y 
CONFIG_PACKAGE_luci-app-openvpn-server=y
CONFIG_PACKAGE_luci-i18n-openvpn-server-zh-cn=y 
CONFIG_PACKAGE_openvpn-easy-rsa=y
CONFIG_PACKAGE_openvpn-openssl=y
